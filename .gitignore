.DS_Store
shots/
web/version.json
# The global ignore has "Icon?" (macOS Icon\r files), which matches icons/ on a
# case-insensitive disk. The app icons are real files: keep them.
!/web/icons/
__pycache__/

# wrangler's cache in the site folder (flarepress).
site/.wrangler/
site/.wrangler.deploy.toml
.flarepress/
