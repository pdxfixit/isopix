# Response headers for Cloudflare Workers Static Assets (and tools/serve.py).
#
# sw.js and version.js must never be cached by the browser or the edge:
# the browser checks sw.js for a new version on each visit, and a cached copy
# would keep installed apps on the old release. version.json is the deploy's
# label and is read with no-store. The manifest needs its proper content type
# for installs. The CSP allows only what the page loads: its own files (no inline
# style or script: colors are set through the style object, never in markup), no <base> and no form post (the sheets' forms are method=dialog,
# which never navigates), and blob:/data: images for trace mode,
# plus Cloudflare Web Analytics' beacon, which Cloudflare adds to the page
# (the owner, 2026-10-15: "i'm ok with cloudflare stats"). Permissions-Policy denies the browser features the app
# never uses; Cross-Origin-Opener-Policy keeps the page in its own browsing context group. HSTS is the zone's setting.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/sw.js
  Cache-Control: no-cache

/version.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store

# The old Isogrid address's page loads move.js from here, as a module, to
# carry its drawings over: a cross-origin module needs CORS.
/move.js
  Access-Control-Allow-Origin: *

/manifest.webmanifest
  Content-Type: application/manifest+json
