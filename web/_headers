# Response headers for Cloudflare Workers Static Assets (and tools/serve.py).
#
# sw.js and version.js must never be cached by the browser or the edge:
# the browser checks sw.js for a new version on each visit, and a cached copy
# would keep installed apps on the old release. version.json is the deploy's
# label and is read with no-store. The manifest needs its proper content type
# for installs. The CSP allows only what the page loads: its own files, inline
# style attributes the swatches set, and blob:/data: images for trace mode.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/sw.js
  Cache-Control: no-cache

/version.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store

/manifest.webmanifest
  Content-Type: application/manifest+json
